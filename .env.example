# HET IT Control System Environment Configuration
# Copy this file to .env and update with your actual values

# Application Settings
HET_APP_NAME=HET IT Control System
HET_APP_VERSION=1.0.0
HET_ENVIRONMENT=development
HET_DEBUG=false

# Database
HET_DATABASE_URL=sqlite:///database/het_control.db
HET_DATABASE_ECHO=false
HET_DATABASE_POOL_SIZE=5
HET_DATABASE_MAX_OVERFLOW=10

# Email Configuration
HET_SMTP_SERVER=smtp.gmail.com
HET_SMTP_PORT=587
HET_SMTP_USERNAME=your-email@gmail.com
HET_SMTP_PASSWORD=your-app-password
HET_EMAIL_RECIPIENTS=admin@company.com,manager@company.com
HET_SMTP_TLS=true

# API Configuration
HET_API_HOST=0.0.0.0
HET_API_PORT=8000
HET_API_DEBUG=false
HET_JWT_SECRET=change-this-in-production-very-long-random-string
HET_JWT_EXPIRATION_HOURS=24

# Logging
HET_LOG_LEVEL=INFO
HET_LOG_MAX_BYTES=10485760
HET_LOG_BACKUP_COUNT=5

# File Paths (use absolute paths for production)
HET_BASE_DIR=/path/to/het/control/system
HET_NAS_BASE=\\het-nas\Tally-Africa
HET_LAUNDRY_BASE=\\het-NAS\G-SSS300
HET_QSYNC_EXE=C:\Program Files (x86)\QNAP\Qsync\Qsync.exe
HET_EXPORT_BASE=/path/to/het/control/system/exports
HET_LOGS_DIR=/path/to/het/control/system/logs
HET_REPORTS_DIR=/path/to/het/control/system/reports
HET_DATABASE_DIR=/path/to/het/control/system/database

# Branch-specific overrides can be added here
# HET_BRANCH_DEFAULT_NAS_BASE=\\server\share
# HET_BRANCH_DEFAULT_EMAIL_RECIPIENTS=branch@company.com